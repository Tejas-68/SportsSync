<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========================================== -->
    <!-- DARK THEME - NOTHING-INSPIRED AESTHETIC   -->
    <!-- ========================================== -->
    
    <style name="Base.Theme.SportsSync" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color - White/Light becomes primary in dark mode -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/gray_200</item>
        <item name="colorOnPrimary">@color/black</item>
        
        <!-- Secondary brand color - Neon accents -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/navigation_bar</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Typography -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        
        <!-- Elevation & Shadows - Enhanced for dark mode -->
        <item name="elevationOverlayEnabled">true</item>
        <item name="elevationOverlayColor">@color/white</item>
        
        <!-- Ripple & State Colors -->
        <item name="colorControlHighlight">@color/ripple</item>
        
        <!-- Error color -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        
        <!-- Accent colors for interactive elements -->
        <item name="colorAccent">@color/accent</item>
    </style>
    
    <!-- ========================================== -->
    <!-- WIDGET OVERRIDES FOR DARK MODE            -->
    <!-- ========================================== -->
    
    <!-- Button styles on dark -->
    <style name="Widget.SportsSync.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="rippleColor">@color/black</item>
    </style>
    
    <style name="Widget.SportsSync.Button.Secondary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_secondary_bg</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="strokeColor">@color/border</item>
        <item name="rippleColor">@color/white</item>
    </style>
    
    <!-- Card styles on dark -->
    <style name="Widget.SportsSync.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@color/glass_border</item>
    </style>
    
    <!-- Text Input on dark -->
    <style name="Widget.SportsSync.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_stroke_focused</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="helperTextTextColor">@color/text_tertiary</item>
        <item name="errorTextColor">@color/error</item>
    </style>
    
    <!-- Chip styles on dark -->
    <style name="Widget.SportsSync.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
    </style>
    
    <!-- Bottom Navigation on dark -->
    <style name="Widget.SportsSync.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/bottom_nav_background</item>
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="itemRippleColor">@color/accent_transparent</item>
        <item name="elevation">8dp</item>
    </style>
    
    <!-- Progress Bar on dark -->
    <style name="Widget.SportsSync.ProgressBar" parent="android:Widget.ProgressBar">
        <item name="android:indeterminateTint">@color/progress_primary</item>
        <item name="android:progressTint">@color/progress_primary</item>
        <item name="android:progressBackgroundTint">@color/progress_background</item>
    </style>
    
    <style name="Widget.SportsSync.ProgressBar.Horizontal" parent="android:Widget.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/progress_primary</item>
        <item name="android:progressBackgroundTint">@color/progress_background</item>
    </style>
    
    <!-- Calendar theme on dark -->
    <style name="Theme.SportsSync.Calendar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorAccent">@color/calendar_today</item>
        <item name="colorPrimary">@color/calendar_selected</item>
        <item name="android:textColorPrimary">@color/calendar_text</item>
        <item name="android:colorBackground">@color/calendar_background</item>
    </style>
    
</resources>
