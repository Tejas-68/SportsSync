<?xml version="1.0" encoding="utf-8"?>
<!-- Neon Glow with Strong Emphasis - Nothing UI -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_cyan_glow" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    
    <!-- Inner Glow -->
    <item 
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_green_glow" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- Core -->
    <item 
        android:left="4dp"
        android:right="4dp"
        android:top="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
