<?xml version="1.0" encoding="utf-8"?>
<!-- Dot Matrix Background - Nothing Technical Aesthetic -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/black" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <!-- Tech Glow Overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/tech_glow"
                android:centerColor="#00000000"
                android:endColor="@color/tech_glow"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <!-- Matrix Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke 
                android:width="1dp" 
                android:color="@color/tech_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
