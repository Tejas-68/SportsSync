<?xml version="1.0" encoding="utf-8"?>
<!-- STUDENT DASHBOARD - NOTHING UI TRANSFORMATION -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:paddingBottom="48dp">

                <!-- Header Section - Nothing Minimal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="32dp"
                    android:paddingBottom="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DASHBOARD"
                        style="@style/TextAppearance.SportsSync.Nothing.DottedHeader"
                        android:textSize="28sp"
                        android:letterSpacing="0.25"/>

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back"
                        style="@style/TextAppearance.SportsSync.Body.Secondary"
                        android:textSize="14sp"
                        android:alpha="0.6"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- Return Item Card - Warning (Nothing Minimal) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReturnItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:visibility="gone"
                    style="@style/Widget.SportsSync.CardView.Nothing"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/warning"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Return Due Today"
                                android:textSize="16sp"
                                style="@style/TextAppearance.SportsSync.Nothing.DottedHeader"
                                android:textColor="@color/warning"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Return items by 5:30 PM"
                                android:textSize="13sp"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReturnItem"
                            style="@style/Widget.SportsSync.Button.Nothing.Filled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Return"
                            android:backgroundTint="@color/warning"
                            android:textColor="@color/text_on_accent"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stats Cards Row - Nothing Minimal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="32dp">

                    <!-- Borrowed Items Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardBorrowedItems"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        style="@style/Widget.SportsSync.CardView.Nothing">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="24dp">

                            <TextView
                                android:id="@+id/tvBorrowedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="40sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BORROWED"
                                android:textSize="11sp"
                                android:letterSpacing="0.1"
                                android:textColor="@color/text_tertiary"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Attendance Status Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAttendance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        style="@style/Widget.SportsSync.CardView.Nothing">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="24dp">

                            <TextView
                                android:id="@+id/tvAttendanceStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Absent"
                                android:textSize="28sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TODAY"
                                android:textSize="11sp"
                                android:letterSpacing="0.1"
                                android:textColor="@color/text_tertiary"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Sport Selection Card - Nothing Minimal -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.SportsSync.CardView.Nothing"
                    android:layout_marginBottom="32dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Borrow Equipment"
                            style="@style/TextAppearance.SportsSync.Nothing.MinimalTitle"
                            android:textSize="18sp"
                            android:layout_marginBottom="20dp"/>

                        <TextView
                            android:id="@+id/tvNoSports"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No sports available"
                            style="@style/TextAppearance.SportsSync.Body.Secondary"
                            android:textSize="14sp"
                            android:visibility="gone"
                            android:layout_marginTop="8dp"/>

                        <ProgressBar
                            android:id="@+id/progressBarSports"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:indeterminateTint="@color/accent"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerSports"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Quick Actions Card - Nothing Minimal -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.SportsSync.CardView.Nothing"
                    android:layout_marginBottom="32dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quick_actions"
                            style="@style/TextAppearance.SportsSync.Nothing.MinimalTitle"
                            android:textSize="18sp"
                            android:layout_marginBottom="20dp"/>

                        <!-- Scan QR Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScanQr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/scan_qr_entry"
                            style="@style/Widget.SportsSync.Button.Nothing.Filled"
                            android:layout_marginBottom="16dp"/>

                        <!-- Exit Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExit"
                            style="@style/Widget.SportsSync.Button.Nothing.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/exit_session"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Account Card - Nothing Minimal -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.SportsSync.CardView.Nothing">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_account"
                            style="@style/TextAppearance.SportsSync.Nothing.MinimalTitle"
                            android:textSize="18sp"
                            android:layout_marginBottom="20dp"/>

                        <!-- My Borrowed Items Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMyBorrowedItems"
                            style="@style/Widget.SportsSync.Button.Nothing.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="My Borrowed Items"
                            android:layout_marginBottom="12dp"/>

                        <!-- Analytics Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAnalytics"
                            style="@style/Widget.SportsSync.Button.Nothing.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="My Statistics"
                            android:layout_marginBottom="12dp"/>

                        <!-- Calendar Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCalendar"
                            style="@style/Widget.SportsSync.Button.Nothing.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Attendance Calendar"
                            android:layout_marginBottom="12dp"/>

                        <!-- Achievements Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAchievements"
                            style="@style/Widget.SportsSync.Button.Nothing.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Achievements"
                            android:layout_marginBottom="12dp"/>

                        <!-- Notifications Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNotifications"
                            style="@style/Widget.SportsSync.Button.Nothing.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Notifications"
                            android:layout_marginBottom="12dp"/>

                        <!-- Edit Profile Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditProfile"
                            style="@style/Widget.SportsSync.Button.Nothing.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Edit Profile"
                            android:layout_marginBottom="12dp"/>

                        <!-- Profile Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProfile"
                            style="@style/Widget.SportsSync.Button.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/view_profile"
                            android:textColor="@color/text_secondary"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Bottom Navigation - Nothing Style -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:menu="@menu/menu_student_bottom_nav"
        style="@style/Widget.SportsSync.BottomNavigationView"
        app:labelVisibilityMode="labeled"
        app:elevation="0dp"
        android:background="?android:colorBackground"
        app:itemIconTint="@color/selector_bottom_nav"
        app:itemTextColor="@color/selector_bottom_nav"/>

</RelativeLayout>