<?xml version="1.0" encoding="utf-8"?>
<!-- STUDENT PROFILE - NOTHING UI -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tvProfileHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFILE"
                style="@style/TextAppearance.SportsSync.Nothing.DottedHeader"
                android:textSize="28sp"
                android:letterSpacing="0.25"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History and achievements"
                style="@style/TextAppearance.SportsSync.Body.Secondary"
                android:textSize="14sp"
                android:alpha="0.6"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.SportsSync.CardView.Nothing"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attendance History"
                    style="@style/TextAppearance.SportsSync.Nothing.MinimalTitle"
                    android:textSize="18sp"
                    android:layout_marginBottom="20dp"/>

                <LinearLayout
                    android:id="@+id/llAttendance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <TextView
                    android:id="@+id/tvNoAttendance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No records yet"
                    style="@style/TextAppearance.SportsSync.Body.Secondary"
                    android:visibility="gone"
                    android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.SportsSync.CardView.Nothing">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Achievements"
                    style="@style/TextAppearance.SportsSync.Nothing.MinimalTitle"
                    android:textSize="18sp"
                    android:layout_marginBottom="20dp"/>

                <LinearLayout
                    android:id="@+id/llAchievements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <TextView
                    android:id="@+id/tvNoAchievements"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No achievements yet"
                    style="@style/TextAppearance.SportsSync.Body.Secondary"
                    android:visibility="gone"
                    android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>