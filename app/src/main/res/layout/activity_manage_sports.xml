<?xml version="1.0" encoding="utf-8"?>
<!-- MANAGE SPORTS - NOTHING UI -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANAGE SPORTS"
                style="@style/TextAppearance.SportsSync.Nothing.DottedHeader"
                android:textSize="22sp"
                android:letterSpacing="0.25"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add and edit sports"
                style="@style/TextAppearance.SportsSync.Body.Secondary"
                android:textSize="14sp"
                android:alpha="0.6"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.SportsSync.CardView.Nothing"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddSport"
                    style="@style/Widget.SportsSync.Button.Nothing.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add New Sport"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:id="@+id/tvEmptyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No sports yet"
                    style="@style/TextAppearance.SportsSync.Body.Secondary"
                    android:visibility="gone"
                    android:layout_gravity="center"
                    android:padding="24dp"/>

                <LinearLayout
                    android:id="@+id/llSportsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerSports"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
