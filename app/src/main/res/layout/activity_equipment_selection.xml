<?xml version="1.0" encoding="utf-8"?>
<!-- EQUIPMENT SELECTION - NOTHING UI -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingBottom="48dp">

        <!-- Header - Nothing Minimal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tvSportName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BASKETBALL"
                style="@style/TextAppearance.SportsSync.Nothing.DottedHeader"
                android:textSize="24sp"
                android:letterSpacing="0.25"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select equipment"
                style="@style/TextAppearance.SportsSync.Body.Secondary"
                android:textSize="14sp"
                android:alpha="0.6"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.SportsSync.CardView.Nothing">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvNoEquipment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No equipment available"
                    style="@style/TextAppearance.SportsSync.Body.Secondary"
                    android:visibility="gone"
                    android:layout_gravity="center"
                    android:padding="32dp"/>

                <ProgressBar
                    android:id="@+id/progressBarEquipment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="@color/accent"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerEquipment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBorrowSelected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Borrow Selected"
                    style="@style/Widget.SportsSync.Button.Nothing.Filled"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
