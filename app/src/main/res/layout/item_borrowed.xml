<?xml version="1.0" encoding="utf-8"?>
<!-- ITEM BORROWED - NOTHING UI (Complete) -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    style="@style/Widget.SportsSync.CardView.Nothing">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sport"
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvEquipment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Equipment"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="x1"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:layout_gravity="center_vertical"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Borrowed: Nov 30"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:id="@+id/tvDeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Due:"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/tvDeadlineDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dec 7"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="@color/error"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReturn"
            style="@style/Widget.SportsSync.Button.Nothing.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Return"
            android:textSize="13sp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
